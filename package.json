{
  "name": "@dataforxyz/orcboss",
  "version": "0.11.0",
  "description": "Pi extension for creating and managing independent Agent Intercom coworkers across Pi, Codex, Claude Code, and OpenCode",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "agent-intercom-fleet": "src/agent-fleet-cli.mjs",
    "agent-intercom-fleet-cleanup": "src/agent-fleet-cleanup.mjs",
    "agent-intercom-access": "src/agent-intercom-access.mjs",
    "agent-intercom-boss-setup": "src/boss-setup-cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dataforxyz/orcboss.git"
  },
  "homepage": "https://github.com/dataforxyz/orcboss#readme",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agents",
    "agent-intercom",
    "orchestration",
    "codex",
    "claude-code",
    "opencode"
  ],
  "files": [
    "src/**/*.ts",
    "src/**/*.mjs",
    "src/guard-bin/git",
    "src/guard-bin/gh",
    "src/guard-bin/tea",
    "src/guard-bin/glab",
    "src/guard-bin/npm",
    "src/guard-bin/gcloud",
    "src/guard-bin/wrangler",
    "src/guard-bin/cloudflared",
    "src/guard-bin/cf",
    "skills/**/*",
    "examples/**/*",
    "docs/**/*",
    "scripts/benchmark-worker-store.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "COPYRIGHT",
    "LICENSE_TRANSITION.md"
  ],
  "scripts": {
    "test": "AGENT_INTERCOM_DISABLE_CLEANUP_TIMER=1 node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "benchmark:worker-store": "node --experimental-strip-types scripts/benchmark-worker-store.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./src/agents-browser.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@dataforxyz/agent-intercom-core": "git+https://github.com/dataforxyz/agent-intercom-core.git#8316cbab548f422ad11c78ed887fabeef94817c1"
  },
  "bundledDependencies": [
    "@dataforxyz/agent-intercom-core"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
